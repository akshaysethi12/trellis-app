{
  "taskTypes": [
    {
      "taskTypeId": "ROOT",
      "description": "Invisible root; its childTaskIds order the top-level sections",
      "createdBy": "seed",
      "isActionable": false,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "taskTypeId": "SECTION",
      "description": "Top-level group",
      "createdBy": "seed",
      "isActionable": false,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "description"
        ]
      }
    },
    {
      "taskTypeId": "TAB",
      "description": "Group of leaf tasks shown together",
      "createdBy": "seed",
      "isActionable": false,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "description"
        ]
      }
    },
    {
      "taskTypeId": "TEXT",
      "description": "Free text. Answer: {textBox: {value}}",
      "createdBy": "seed",
      "isActionable": true,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "textBox": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "errorMessage": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ALPHANUMERIC",
                  "ALPHABETIC",
                  "NUMERIC"
                ]
              }
            }
          }
        },
        "required": [
          "description",
          "textBox"
        ]
      }
    },
    {
      "taskTypeId": "RADIO_BUTTON",
      "description": "Single choice. Answer: {radioButton: {option}}",
      "createdBy": "seed",
      "isActionable": true,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "radioButton": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "errorMessage": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        },
        "required": [
          "description",
          "radioButton"
        ]
      }
    },
    {
      "taskTypeId": "DROPDOWN",
      "description": "Single choice from a list. Answer: {dropdown: {option}}",
      "createdBy": "seed",
      "isActionable": true,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "dropdown": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "errorMessage": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        },
        "required": [
          "description",
          "dropdown"
        ]
      }
    },
    {
      "taskTypeId": "CHECKBOX",
      "description": "One or more ticks. Answer: {checkbox: [{option}]}",
      "createdBy": "seed",
      "isActionable": true,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkbox": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "errorMessage": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        },
        "required": [
          "description",
          "checkbox"
        ]
      }
    },
    {
      "taskTypeId": "IMAGE",
      "description": "Photo. Answer: {image: [{path, hashKey, timestamp}]}",
      "createdBy": "seed",
      "isActionable": true,
      "metaSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "errorMessage": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "hashKey"
                  ],
                  "properties": {
                    "hashKey": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "sideEffectBeans": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "description",
          "image"
        ]
      }
    }
  ],
  "workflows": [
    {
      "workflowCode": "LOAN_APPLICATION",
      "name": "Personal loan application",
      "description": "Five-page personal loan journey: applicant, employment, loan and EMI, documents, consent",
      "tenantId": "DEFAULT",
      "publish": true,
      "tasks": [
        {
          "taskId": "root",
          "taskType": "ROOT",
          "meta": {},
          "childTaskIds": [
            "applicant",
            "employment",
            "loan",
            "documents",
            "review"
          ]
        },
        {
          "taskId": "applicant",
          "taskType": "SECTION",
          "parentTaskId": "root",
          "meta": {
            "description": "Applicant details",
            "icon": "person"
          },
          "childTaskIds": [
            "applicant_tab"
          ]
        },
        {
          "taskId": "applicant_tab",
          "taskType": "TAB",
          "parentTaskId": "applicant",
          "meta": {
            "description": "Personal details"
          },
          "childTaskIds": [
            "full_name",
            "mobile_number",
            "pan_number",
            "city"
          ]
        },
        {
          "taskId": "employment",
          "taskType": "SECTION",
          "parentTaskId": "root",
          "meta": {
            "description": "Employment & income",
            "icon": "work"
          },
          "childTaskIds": [
            "employment_tab"
          ]
        },
        {
          "taskId": "employment_tab",
          "taskType": "TAB",
          "parentTaskId": "employment",
          "meta": {
            "description": "Work and income"
          },
          "childTaskIds": [
            "employment_type",
            "employer_name",
            "business_name",
            "monthly_income"
          ]
        },
        {
          "taskId": "loan",
          "taskType": "SECTION",
          "parentTaskId": "root",
          "meta": {
            "description": "Loan requirement",
            "icon": "payments"
          },
          "childTaskIds": [
            "loan_tab"
          ]
        },
        {
          "taskId": "loan_tab",
          "taskType": "TAB",
          "parentTaskId": "loan",
          "meta": {
            "description": "Amount and tenure"
          },
          "childTaskIds": [
            "loan_purpose",
            "loan_amount",
            "tenure_months",
            "emi_summary",
            "co_applicant_count",
            "co_applicant_1_name",
            "co_applicant_2_name"
          ]
        },
        {
          "taskId": "documents",
          "taskType": "SECTION",
          "parentTaskId": "root",
          "meta": {
            "description": "Documents",
            "icon": "badge"
          },
          "childTaskIds": [
            "documents_tab"
          ]
        },
        {
          "taskId": "documents_tab",
          "taskType": "TAB",
          "parentTaskId": "documents",
          "meta": {
            "description": "Upload documents"
          },
          "childTaskIds": [
            "pan_card_photo",
            "selfie",
            "salary_slip",
            "bank_statement"
          ]
        },
        {
          "taskId": "review",
          "taskType": "SECTION",
          "parentTaskId": "root",
          "meta": {
            "description": "Review & consent",
            "icon": "verified"
          },
          "childTaskIds": [
            "review_tab"
          ]
        },
        {
          "taskId": "review_tab",
          "taskType": "TAB",
          "parentTaskId": "review",
          "meta": {
            "description": "Consent"
          },
          "childTaskIds": [
            "terms_consent"
          ]
        },
        {
          "taskId": "full_name",
          "taskType": "TEXT",
          "parentTaskId": "applicant_tab",
          "meta": {
            "description": "Full name (as on PAN)",
            "textBox": {
              "required": true,
              "description": "Your full name",
              "type": "ALPHABETIC"
            }
          },
          "validationHooks": [
            {
              "name": "min-length",
              "type": "beanValidationHook",
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "config": {
                "beanName": "minLengthValidator",
                "metadata": {
                  "minLength": 3
                }
              }
            }
          ]
        },
        {
          "taskId": "mobile_number",
          "taskType": "TEXT",
          "parentTaskId": "applicant_tab",
          "meta": {
            "description": "Mobile number",
            "textBox": {
              "required": true,
              "description": "10-digit mobile number",
              "type": "NUMERIC"
            }
          },
          "validationHooks": [
            {
              "name": "mobile-verification",
              "type": "httpValidationHook",
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "config": {
                "url": "${trellis.app.mock-base-url}/mock/mobile-check",
                "method": "POST",
                "requestMappings": {
                  "mobile": "${capturedValue.textBox.value}",
                  "assetId": "${assetId}"
                }
              }
            }
          ]
        },
        {
          "taskId": "pan_number",
          "taskType": "TEXT",
          "parentTaskId": "applicant_tab",
          "meta": {
            "description": "PAN",
            "textBox": {
              "required": true,
              "description": "ABCDE1234F",
              "type": "ALPHANUMERIC"
            }
          },
          "validationHooks": [
            {
              "name": "pan-format",
              "type": "beanValidationHook",
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "config": {
                "beanName": "panFormatValidator"
              }
            }
          ]
        },
        {
          "taskId": "city",
          "taskType": "DROPDOWN",
          "parentTaskId": "applicant_tab",
          "meta": {
            "description": "City",
            "dropdown": {
              "required": true,
              "options": [
                "Bengaluru",
                "Delhi",
                "Mumbai",
                "Hyderabad",
                "Pune",
                "Other"
              ]
            }
          }
        },
        {
          "taskId": "employment_type",
          "taskType": "RADIO_BUTTON",
          "parentTaskId": "employment_tab",
          "meta": {
            "description": "Employment type",
            "radioButton": {
              "required": true,
              "options": [
                "Salaried",
                "Self-employed"
              ]
            }
          },
          "dependencies": [
            {
              "dependentTaskIds": [
                "employer_name",
                "salary_slip"
              ],
              "action": "TASK_VISIBILITY_ACTION",
              "config": {
                "path": "${capturedValue.radioButton.option}",
                "dependentValue": "Salaried",
                "activate": true
              }
            },
            {
              "dependentTaskIds": [
                "business_name",
                "bank_statement"
              ],
              "action": "TASK_VISIBILITY_ACTION",
              "config": {
                "path": "${capturedValue.radioButton.option}",
                "dependentValue": "Self-employed",
                "activate": true
              }
            }
          ]
        },
        {
          "taskId": "employer_name",
          "taskType": "TEXT",
          "parentTaskId": "employment_tab",
          "meta": {
            "description": "Employer name",
            "textBox": {
              "required": true,
              "description": "Company you work for",
              "type": "ALPHANUMERIC"
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "business_name",
          "taskType": "TEXT",
          "parentTaskId": "employment_tab",
          "meta": {
            "description": "Business name",
            "textBox": {
              "required": true,
              "description": "Registered business name",
              "type": "ALPHANUMERIC"
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "monthly_income",
          "taskType": "TEXT",
          "parentTaskId": "employment_tab",
          "meta": {
            "description": "Monthly income (Rs)",
            "textBox": {
              "required": true,
              "description": "Take-home pay per month",
              "type": "NUMERIC"
            }
          },
          "validationHooks": [
            {
              "name": "income-range",
              "type": "beanValidationHook",
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "config": {
                "beanName": "numberRangeValidator",
                "metadata": {
                  "min": 15000,
                  "max": 10000000,
                  "label": "Monthly income"
                }
              }
            }
          ]
        },
        {
          "taskId": "loan_purpose",
          "taskType": "DROPDOWN",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Purpose of the loan",
            "dropdown": {
              "required": true,
              "options": [
                "Home renovation",
                "Education",
                "Medical",
                "Wedding",
                "Travel",
                "Vehicle purchase",
                "Other"
              ]
            }
          }
        },
        {
          "taskId": "loan_amount",
          "taskType": "TEXT",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Loan amount (Rs)",
            "textBox": {
              "required": true,
              "description": "Between 50,000 and 25,00,000",
              "type": "NUMERIC"
            }
          },
          "dependencyBean": "emiCalculator",
          "validationHooks": [
            {
              "name": "amount-range",
              "type": "beanValidationHook",
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "config": {
                "beanName": "numberRangeValidator",
                "metadata": {
                  "min": 50000,
                  "max": 2500000,
                  "label": "Loan amount"
                }
              }
            }
          ]
        },
        {
          "taskId": "tenure_months",
          "taskType": "DROPDOWN",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Tenure",
            "dropdown": {
              "required": true,
              "options": [
                "12 months",
                "24 months",
                "36 months",
                "48 months",
                "60 months"
              ]
            }
          },
          "dependencyBean": "emiCalculator"
        },
        {
          "taskId": "emi_summary",
          "taskType": "TEXT",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Your EMI",
            "textBox": {
              "required": false,
              "description": "Calculated from amount and tenure",
              "type": "ALPHANUMERIC"
            }
          },
          "isSystemInput": true
        },
        {
          "taskId": "co_applicant_count",
          "taskType": "DROPDOWN",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Number of co-applicants",
            "dropdown": {
              "required": true,
              "options": [
                "0",
                "1",
                "2"
              ]
            }
          },
          "dependencies": [
            {
              "dependentTaskIds": [
                "co_applicant_1_name",
                "co_applicant_2_name"
              ],
              "action": "NUMERIC_TASK_ACTIVATION_ACTION",
              "config": {
                "path": "${capturedValue.dropdown.option}"
              }
            }
          ]
        },
        {
          "taskId": "co_applicant_1_name",
          "taskType": "TEXT",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Co-applicant 1 name",
            "textBox": {
              "required": true,
              "description": "Full name",
              "type": "ALPHABETIC"
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "co_applicant_2_name",
          "taskType": "TEXT",
          "parentTaskId": "loan_tab",
          "meta": {
            "description": "Co-applicant 2 name",
            "textBox": {
              "required": true,
              "description": "Full name",
              "type": "ALPHABETIC"
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "pan_card_photo",
          "taskType": "IMAGE",
          "parentTaskId": "documents_tab",
          "meta": {
            "description": "PAN card",
            "image": {
              "required": true,
              "options": [
                {
                  "hashKey": "pan_front",
                  "description": "Front of PAN card",
                  "required": true,
                  "sideEffectBeans": [
                    "documentCheck"
                  ]
                }
              ]
            }
          }
        },
        {
          "taskId": "selfie",
          "taskType": "IMAGE",
          "parentTaskId": "documents_tab",
          "meta": {
            "description": "Selfie",
            "image": {
              "required": true,
              "options": [
                {
                  "hashKey": "selfie",
                  "description": "A clear photo of your face",
                  "required": true,
                  "sideEffectBeans": [
                    "documentCheck"
                  ]
                }
              ]
            }
          }
        },
        {
          "taskId": "salary_slip",
          "taskType": "IMAGE",
          "parentTaskId": "documents_tab",
          "meta": {
            "description": "Latest salary slip",
            "image": {
              "required": true,
              "options": [
                {
                  "hashKey": "salary_slip_1",
                  "description": "Last month's salary slip",
                  "required": true,
                  "sideEffectBeans": [
                    "documentCheck"
                  ]
                }
              ]
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "bank_statement",
          "taskType": "IMAGE",
          "parentTaskId": "documents_tab",
          "meta": {
            "description": "Bank statement",
            "image": {
              "required": true,
              "options": [
                {
                  "hashKey": "bank_statement_1",
                  "description": "Last 6 months' bank statement",
                  "required": true,
                  "sideEffectBeans": [
                    "documentCheck"
                  ]
                }
              ]
            }
          },
          "isActiveByDefault": false
        },
        {
          "taskId": "terms_consent",
          "taskType": "CHECKBOX",
          "parentTaskId": "review_tab",
          "meta": {
            "description": "Consent",
            "checkbox": {
              "required": true,
              "options": [
                "I agree to the loan terms and allow a credit bureau check"
              ]
            }
          },
          "hooks": [
            {
              "name": "consent-webhook",
              "type": "httpHook",
              "async": false,
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "executionCondition": "['taskStatus'] == 'COMPLETED'",
              "config": {
                "url": "${trellis.app.mock-base-url}/mock/webhooks/consent-given",
                "method": "POST",
                "headers": {
                  "X-Source": "trellis"
                },
                "requestMappings": {
                  "event": "CONSENT_GIVEN",
                  "assetId": "${assetId}",
                  "workflowCode": "${workflowCode}",
                  "applicantName": "${capturedTaskData.capturedTasks.full_name.capturedValue.textBox.value}",
                  "loanAmount": "${capturedTaskData.capturedTasks.loan_amount.capturedValue.textBox.value}",
                  "emiSummary": "${capturedTaskData.capturedTasks.emi_summary.capturedValue.textBox.value}",
                  "consent": "${capturedValue.checkbox}"
                }
              }
            },
            {
              "name": "credit-check",
              "type": "beanHook",
              "async": true,
              "taskLifecycleTypes": [
                "TASK_DATA_CAPTURED"
              ],
              "executionCondition": "['taskStatus'] == 'COMPLETED'",
              "config": {
                "beanName": "creditCheckRequest"
              }
            }
          ]
        }
      ]
    }
  ]
}