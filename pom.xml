<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>io.trellis</groupId>
    <artifactId>trellis-app</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>trellis-app</name>
    <description>Runnable Trellis service: host beans, execution API, examples</description>
    <url>https://github.com/akshaysethi12/trellis-app</url>

    <properties>
        <java.version>21</java.version>
        <!-- Trellis library version from GitHub Packages. Override with -Dtrellis.version=... -->
        <trellis.version>0.1.0</trellis.version>
    </properties>

    <!--
        Trellis is published to GitHub Packages, which needs a token even for downloads.
        Add a <server> with id "github-trellis" to ~/.m2/settings.xml (see README).
    -->
    <repositories>
        <repository>
            <id>github-trellis</id>
            <name>Trellis on GitHub Packages</name>
            <url>https://maven.pkg.github.com/akshaysethi12/trellis</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.trellis</groupId>
            <artifactId>trellis-api</artifactId>
            <version>${trellis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.trellis</groupId>
            <artifactId>trellis-client</artifactId>
            <version>${trellis.version}</version>
        </dependency>
        <dependency>
            <groupId>io.trellis</groupId>
            <artifactId>trellis-core</artifactId>
            <version>${trellis.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.trellis.app.TrellisApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
